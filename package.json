{
  "name": "xiaoke-freecell",
  "productName": "小柯機器人接龍遊戲",
  "version": "1.0.1",
  "description": "小柯機器人接龍遊戲：3D 新接龍（FreeCell）同局比快（真人對 AI、AI 對 AI、遠端真人＋語音、單人練習、AI 軍師代打、速算解算器與牌譜庫、動畫語音教學、背景音樂、自動更新）",
  "main": "src/main/main.js",
  "author": {
    "name": "吳玉柱",
    "email": "achir1015@gmail.com"
  },
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/",
    "csp": "node scripts/csp.mjs",
    "music": "python scripts/gen_music.py",
    "icon": "python scripts/make_icon.py",
    "portraits": "node scripts/gen_portraits.mjs",
    "dist:win": "electron-builder --win nsis portable --x64 --publish never",
    "dist:mac": "electron-builder --mac dmg --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "peerjs": "1.5.5",
    "three": "0.170.0"
  },
  "build": {
    "appId": "com.achir.xiaokefreecell",
    "productName": "小柯機器人接龍遊戲",
    "artifactName": "XiaokeFreecell-${version}-${os}-${arch}.${ext}",
    "copyright": "Copyright © 2026 吳玉柱",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/portraits/_sheet.html",
      "build/icon.png",
      "package.json",
      "LICENSE",
      "node_modules/**/*",
      "!node_modules/three/examples/**",
      "!node_modules/three/src/**",
      "!node_modules/**/test/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "!mobile/**",
      "!android/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "executableName": "XiaokeFreecell"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "小柯機器人接龍遊戲",
      "uninstallDisplayName": "小柯機器人接龍遊戲",
      "language": "1028",
      "installerLanguages": [
        "zh_TW"
      ]
    },
    "portable": {
      "artifactName": "XiaokeFreecell-${version}-win-x64-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.png",
      "category": "public.app-category.card-games",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "與遠端玩家語音通話需要使用麥克風。"
      },
      "identity": "-"
    },
    "dmg": {
      "title": "小柯機器人接龍遊戲 ${version}"
    },
    "npmRebuild": false,
    "afterSign": "build/adhoc-sign.cjs"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.2",
    "peer": "^1.0.2",
    "playwright-core": "^1.48.2"
  }
}
